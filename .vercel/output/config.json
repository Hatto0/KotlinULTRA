{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": none,
  "routes": [
    {
      "headers": {
        "cache-control": "private, max-age=86400, mutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "/assets/(.*)"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}